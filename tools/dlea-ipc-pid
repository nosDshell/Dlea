. "$(dirname "${BASH_SOURCE[0]}")/dlea-ipc"
# The pid of the one Dlea running a given ui tree, because a path is not an instance selector.
#
#   . tools/dlea-ipc-pid
#   pid=$(dlea_ipc_pid "$PWD/ui") || exit 1
#   qs ipc --pid "$pid" call dlea tokens
#
# qs ipc -p <path> resolves a path only as far as the config's ShellId, and every tree's shell.qml
# declares the same "//@ pragma ShellId dlea", so one namespace holds every Dlea this box has run.
# A path-addressed call answers from the oldest live instance in that namespace, whatever tree it is
# running: measured 2026-09-02, `qs ipc -p ~/Work/claude/dlea/ui call dlea path` answered from an
# instance of /usr/share/dlea/ui that had had no window for two hours. This build of qs has no
# --newest, so --pid is its only exact selector, and it is also the only one that works from a
# session with no WAYLAND_DISPLAY, which -p and --id silently refuse.

# Sample input, one block per instance from `qs list --all`:
#   Instance fgf81k9vqkt:
#     Process ID: 2072895
#     Shell ID: dlea
#     Config path: /usr/share/dlea/ui/boot/shell.qml
dlea_ipc_pids() {
  if [[ -n ${DLEA_TEST_WINDOWS_ROOT:-} ]]; then
    LC_ALL=C.UTF-8 LANGUAGE= python3 -B "$(dirname "$DLEA_IPC_HELPER")/../tests/lib/dlea_transport_cli.py" lookup "$DLEA_TEST_WINDOWS_ROOT" "$1"
    return $?
  fi
  local want="$1/boot/shell.qml" pid= line
  while IFS= read -r line; do
    case $line in
      "Instance "*) pid= ;;
      *"Process ID: "*) pid=${line##*": "} ;;
      *"Config path: "*) [ "${line##*": "}" = "$want" ] && printf '%s\n' "$pid" ;;
    esac
  done < <(LC_ALL=C.UTF-8 LANGUAGE= dlea_ipc_list --all 2>/dev/null)
}

# Refuses rather than picks: two instances at one path is the exact state that produced a wrong
# reading, so the caller is told instead of being handed whichever one qs happened to reach first.
dlea_ipc_pid() {
  local ui="$1" pids
  pids=$(dlea_ipc_pids "$ui" | LC_ALL=C.UTF-8 LANGUAGE= tr '\n' ' ')
  set -- $pids
  case $# in
    0) echo "dlea-ipc-pid: no Dlea is running from $ui" >&2; return 1 ;;
    1) printf '%s\n' "$1" ;;
    *) echo "dlea-ipc-pid: $# Dlea instances run from $ui (pids $pids), so no reading is attributable" >&2; return 1 ;;
  esac
}
