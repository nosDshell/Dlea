# Sourced by image fixture tools; fontconfig failure leaves ImageMagick's default in use.
if [[ ${dlea_magick_font_ready:-0} == 1 ]]; then return 0; fi
dlea_magick_font_ready=1
dlea_magick_font_args=()
dlea_magick_font_wait_s=10
if dlea_magick_font_file=$(timeout "$dlea_magick_font_wait_s" fc-match -f '%{file}' monospace 2>/dev/null) \
    && [[ $dlea_magick_font_file == /* && -f $dlea_magick_font_file && -r $dlea_magick_font_file ]]; then
    dlea_magick_font_args=(-font "$dlea_magick_font_file")
fi
unset dlea_magick_font_file dlea_magick_font_wait_s
